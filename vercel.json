{
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://khanakro.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://khanakro.firebaseapp.com/__/firebase/:path*" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
